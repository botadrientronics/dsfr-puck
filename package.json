{
  "name": "dsfr-puck",
  "version": "1.0.0",
  "description": "Intégration des composants react-dsfr avec Puck Editor - Bibliothèque pour utiliser le Système de Design de l'État avec Puck",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest",
    "prepublish": "npm run build"
  },
  "keywords": [
    "dsfr",
    "react-dsfr",
    "puck",
    "react",
    "editor",
    "visual-editor",
    "gouv",
    "systeme-de-design",
    "codegouvfr"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/votre-org/dsfr-puck.git"
  },
  "bugs": {
    "url": "https://github.com/votre-org/dsfr-puck/issues"
  },
  "homepage": "https://github.com/votre-org/dsfr-puck#readme",
  "peerDependencies": {
    "@codegouvfr/react-dsfr": "^1.34.0",
    "@puckeditor/core": "^0.17.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./config": {
      "import": "./dist/config/index.mjs",
      "require": "./dist/config/index.js",
      "types": "./dist/config/index.d.ts"
    }
  }
}
